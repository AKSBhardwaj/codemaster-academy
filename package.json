{
  "name": "codemaster-academy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run content:build",
    "start": "ng serve",
    "prebuild": "npm run content:build",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "preview": "serve -s dist/codemaster-academy/browser -l 4173",
    "content:build": "tsx tools/content/cli.ts build",
    "content:validate": "tsx tools/content/cli.ts validate",
    "icons:build": "tsx tools/icons/build-ui-icons.ts && tsx tools/icons/copy-tech-icons.ts",
    "test": "ng test",
    "test:e2e": "playwright test",
    "lint": "ng lint",
    "lint:tools": "tsc -p tools/tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"tools/**/*.ts\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"tools/**/*.ts\" \"e2e/**/*.ts\"",
    "postbuild": "tsx tools/build/postbuild.ts",
    "pretest:e2e": "npm run content:build"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "bootstrap": "^5.3.9",
    "codemirror": "^6.0.2",
    "minisearch": "^7.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.12.0",
    "@types/sql.js": "^1.4.11",
    "angular-eslint": "22.6.0",
    "bootstrap-icons": "^1.13.2",
    "devicon": "^2.18.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "serve": "^14.2.8",
    "shiki": "^4.6.0",
    "sql.js": "^1.16.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.7"
  }
}
