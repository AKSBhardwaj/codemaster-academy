{
  "json.schemas": [
    {
      "fileMatch": [
        "/src/assets/content/catalog/categories.json"
      ],
      "url": "./src/assets/content/schemas/categories.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/catalog/technologies/*.json"
      ],
      "url": "./src/assets/content/schemas/technologies.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/learning-paths/*.json"
      ],
      "url": "./src/assets/content/schemas/learning-path.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/site/home.json"
      ],
      "url": "./src/assets/content/schemas/home.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/technologies/*/overview.json"
      ],
      "url": "./src/assets/content/schemas/overview.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/technologies/*/lessons/*.json"
      ],
      "url": "./src/assets/content/schemas/lesson.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/technologies/*/exercises.json"
      ],
      "url": "./src/assets/content/schemas/exercises.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/technologies/*/quiz.json"
      ],
      "url": "./src/assets/content/schemas/quiz.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/technologies/*/reference.json"
      ],
      "url": "./src/assets/content/schemas/reference.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/technologies/*/examples.json"
      ],
      "url": "./src/assets/content/schemas/examples.schema.json"
    },
    {
      "fileMatch": [
        "/src/assets/content/site/playground.json"
      ],
      "url": "./src/assets/content/schemas/playground.schema.json"
    }
  ],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "typescript.tsdk": "node_modules/typescript/lib"
}
