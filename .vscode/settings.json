{
  "json.schemas": [
    { "fileMatch": ["/src/assets/content/catalog/categories.json"], "url": "./src/assets/content/schemas/categories.schema.json" },
    { "fileMatch": ["/src/assets/content/catalog/technologies/*.json"], "url": "./src/assets/content/schemas/technologies.schema.json" },
    { "fileMatch": ["/src/assets/content/learning-paths/*.json"], "url": "./src/assets/content/schemas/learning-path.schema.json" },
    { "fileMatch": ["/src/assets/content/site/home.json"], "url": "./src/assets/content/schemas/home.schema.json" }
  ],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "typescript.tsdk": "node_modules/typescript/lib"
}
