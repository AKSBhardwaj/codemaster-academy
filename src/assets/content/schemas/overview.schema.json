{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 150,
      "maxLength": 900
    },
    "versionNote": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "whatYouWillLearn": {
      "minItems": 3,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 140
      }
    },
    "learningObjectives": {
      "minItems": 3,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 160
      }
    },
    "sidebarCategories": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "lessonSlugs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "lessonSlugs"
        ],
        "additionalProperties": false
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "minLength": 50,
          "maxLength": 170
        },
        "keywords": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "image": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "slug",
    "description",
    "whatYouWillLearn",
    "learningObjectives",
    "sidebarCategories",
    "seo"
  ],
  "additionalProperties": false
}
