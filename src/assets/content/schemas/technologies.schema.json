{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "categorySlug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "difficulty": {
        "type": "string",
        "enum": [
          "beginner",
          "intermediate",
          "advanced"
        ]
      },
      "featured": {
        "type": "boolean"
      },
      "popular": {
        "type": "boolean"
      },
      "icon": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "logo",
              "glyph"
            ]
          },
          "src": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "src"
        ],
        "additionalProperties": false
      },
      "tags": {
        "minItems": 1,
        "maxItems": 6,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        }
      },
      "prerequisites": {
        "maxItems": 5,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "shortDescription": {
        "type": "string",
        "minLength": 80,
        "maxLength": 280
      },
      "highlights": {
        "minItems": 3,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 8,
          "maxLength": 90
        }
      }
    },
    "required": [
      "slug",
      "name",
      "categorySlug",
      "difficulty",
      "featured",
      "popular",
      "icon",
      "tags",
      "prerequisites",
      "shortDescription",
      "highlights"
    ],
    "additionalProperties": false
  }
}
