{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "popularLanguages": {
      "minItems": 6,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "popularFrameworks": {
      "minItems": 6,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "featuredPaths": {
      "minItems": 3,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "whyUs": {
      "minItems": 3,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "text": {
            "type": "string",
            "minLength": 40,
            "maxLength": 240
          }
        },
        "required": [
          "icon",
          "title",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "faq": {
      "minItems": 4,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 140
          },
          "answer": {
            "type": "string",
            "minLength": 40,
            "maxLength": 600
          }
        },
        "required": [
          "question",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "playgroundPromo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 40,
          "maxLength": 300
        },
        "bullets": {
          "minItems": 2,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 90
          }
        }
      },
      "required": [
        "title",
        "text",
        "bullets"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "popularLanguages",
    "popularFrameworks",
    "featuredPaths",
    "whyUs",
    "faq",
    "playgroundPromo"
  ],
  "additionalProperties": false
}
