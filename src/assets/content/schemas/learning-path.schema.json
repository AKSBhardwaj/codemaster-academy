{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50
    },
    "tagline": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 420
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stages": {
      "minItems": 3,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "minLength": 40,
            "maxLength": 320
          },
          "technologySlug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "alternativeSlugs": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "lessonSlugs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "topicNote": {
            "type": "string",
            "minLength": 20,
            "maxLength": 320
          },
          "estimatedHours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 200
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "estimatedHours"
        ],
        "additionalProperties": false
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "minLength": 50,
          "maxLength": 170
        },
        "keywords": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "image": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "slug",
    "title",
    "tagline",
    "description",
    "icon",
    "audience",
    "level",
    "featured",
    "order",
    "stages",
    "seo"
  ],
  "additionalProperties": false
}
