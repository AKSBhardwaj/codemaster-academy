{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 3,
        "maxLength": 40
      },
      "shortName": {
        "type": "string",
        "minLength": 2,
        "maxLength": 20
      },
      "description": {
        "type": "string",
        "minLength": 60,
        "maxLength": 220
      },
      "icon": {
        "type": "string",
        "minLength": 1
      },
      "accent": {
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "order": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "slug",
      "name",
      "shortName",
      "description",
      "icon",
      "accent",
      "order"
    ],
    "additionalProperties": false
  }
}
