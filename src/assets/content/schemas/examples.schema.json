{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 300
    },
    "examples": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "output": {
            "type": "string",
            "maxLength": 4000
          },
          "runnable": {
            "type": "boolean"
          },
          "tags": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 24
            }
          },
          "lessonSlug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "language",
          "code",
          "runnable",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "description",
    "examples"
  ],
  "additionalProperties": false
}
