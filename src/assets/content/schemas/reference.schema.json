{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 300
    },
    "groups": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "entries": {
            "minItems": 1,
            "maxItems": 120,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "summary": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 300
                },
                "syntax": {
                  "type": "string",
                  "maxLength": 300
                },
                "example": {
                  "type": "object",
                  "properties": {
                    "language": {
                      "type": "string",
                      "minLength": 1
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "language",
                    "code"
                  ],
                  "additionalProperties": false
                },
                "notes": {
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 240
                  }
                },
                "lessonSlug": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "required": [
                "slug",
                "name",
                "summary"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "entries"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "description",
    "groups"
  ],
  "additionalProperties": false
}
