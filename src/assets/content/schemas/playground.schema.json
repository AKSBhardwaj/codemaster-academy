{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "languages": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "editorLanguage": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "enum": [
              "browser",
              "wasm",
              "server",
              "unavailable"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "templates": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 60
                },
                "description": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 160
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "required": [
                "id",
                "title",
                "description",
                "code"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "editorLanguage",
          "capability",
          "templates"
        ],
        "additionalProperties": false
      }
    },
    "sqlSetup": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "sqlSchemaSummary": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string"
          },
          "columns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "table",
          "columns"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "languages",
    "sqlSetup",
    "sqlSchemaSummary"
  ],
  "additionalProperties": false
}
