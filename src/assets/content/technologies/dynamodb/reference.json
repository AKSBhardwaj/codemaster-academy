{
  "title": "DynamoDB Quick Guide",
  "description": "Find a short explanation and a worked example for each idea in the DynamoDB course.",
  "groups": [
    {
      "id": "first-steps",
      "title": "First steps",
      "entries": [
        {
          "slug": "introduction",
          "name": "Design the item key",
          "summary": "A partition key chooses an item group. A sort key identifies and orders items within that group.",
          "example": {
            "language": "json",
            "code": "{\"reader\":{\"S\":\"mia\"},\"book\":{\"S\":\"moon-trip\"},\"title\":{\"S\":\"Moon Trip\"},\"pages\":{\"N\":\"60\"}}"
          },
          "lessonSlug": "introduction"
        },
        {
          "slug": "create-a-local-keyed-table",
          "name": "Create a local keyed table",
          "summary": "A DynamoDB table declares its key attributes.",
          "example": {
            "language": "bash",
            "code": "aws dynamodb create-table --table-name cma-books --attribute-definitions AttributeName=reader,AttributeType=S AttributeName=book,AttributeType=S --key-schema AttributeName=reader,KeyType=HASH AttributeName=book,KeyType=RANGE --billing-mode PAY_PER_REQUEST --endpoint-url http://localhost:8000"
          },
          "lessonSlug": "create-a-local-keyed-table"
        },
        {
          "slug": "write-a-known-item",
          "name": "Write a known item",
          "summary": "PutItem writes a complete item at its key.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"Item\":{\"reader\":{\"S\":\"mia\"},\"book\":{\"S\":\"moon-trip\"},\"title\":{\"S\":\"Moon Trip\"},\"pages\":{\"N\":\"60\"}}}"
          },
          "lessonSlug": "write-a-known-item"
        },
        {
          "slug": "read-an-exact-key",
          "name": "Read an exact key",
          "summary": "GetItem reads one item by its complete primary key.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"Key\":{\"reader\":{\"S\":\"mia\"},\"book\":{\"S\":\"moon-trip\"}},\"ConsistentRead\":true}"
          },
          "lessonSlug": "read-an-exact-key"
        }
      ]
    },
    {
      "id": "build-skills",
      "title": "Build your skills",
      "entries": [
        {
          "slug": "query-one-partition",
          "name": "Query one partition",
          "summary": "Query selects one partition key and can return its related items.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"KeyConditionExpression\":\"#reader = :reader\",\"ExpressionAttributeNames\":{\"#reader\":\"reader\"},\"ExpressionAttributeValues\":{\":reader\":{\"S\":\"mia\"}}}"
          },
          "lessonSlug": "query-one-partition"
        },
        {
          "slug": "use-a-sort-key-prefix",
          "name": "Use a sort-key prefix",
          "summary": "A sort key can support a range or prefix inside one partition.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"KeyConditionExpression\":\"#reader=:reader AND begins_with(#book,:prefix)\",\"ExpressionAttributeNames\":{\"#reader\":\"reader\",\"#book\":\"book\"},\"ExpressionAttributeValues\":{\":reader\":{\"S\":\"mia\"},\":prefix\":{\"S\":\"moon\"}}}"
          },
          "lessonSlug": "use-a-sort-key-prefix"
        },
        {
          "slug": "read-all-result-pages",
          "name": "Read all result pages",
          "summary": "A Query response can be only one page of data.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"KeyConditionExpression\":\"#reader=:reader\",\"ExpressionAttributeNames\":{\"#reader\":\"reader\"},\"ExpressionAttributeValues\":{\":reader\":{\"S\":\"mia\"}},\"Limit\":1}"
          },
          "lessonSlug": "read-all-result-pages"
        },
        {
          "slug": "update-one-attribute",
          "name": "Update one attribute",
          "summary": "UpdateItem can change selected attributes at a key.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"Key\":{\"reader\":{\"S\":\"mia\"},\"book\":{\"S\":\"moon-trip\"}},\"UpdateExpression\":\"SET #pages=:pages\",\"ExpressionAttributeNames\":{\"#pages\":\"pages\"},\"ExpressionAttributeValues\":{\":pages\":{\"N\":\"64\"}},\"ReturnValues\":\"ALL_NEW\"}"
          },
          "lessonSlug": "update-one-attribute"
        }
      ]
    },
    {
      "id": "put-together",
      "title": "Put it together",
      "entries": [
        {
          "slug": "avoid-replacing-an-existing-item",
          "name": "Avoid replacing an existing item",
          "summary": "A conditional put can require that a key does not already exist.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"Item\":{\"reader\":{\"S\":\"mia\"},\"book\":{\"S\":\"moon-trip\"},\"title\":{\"S\":\"Another title\"}},\"ConditionExpression\":\"attribute_not_exists(#reader)\",\"ExpressionAttributeNames\":{\"#reader\":\"reader\"}}"
          },
          "lessonSlug": "avoid-replacing-an-existing-item"
        },
        {
          "slug": "understand-filters-and-read-cost",
          "name": "Understand filters and read cost",
          "summary": "A FilterExpression removes items after DynamoDB reads the key-matching data.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"KeyConditionExpression\":\"#reader=:reader\",\"FilterExpression\":\"#pages>=:minimum\",\"ExpressionAttributeNames\":{\"#reader\":\"reader\",\"#pages\":\"pages\"},\"ExpressionAttributeValues\":{\":reader\":{\"S\":\"mia\"},\":minimum\":{\"N\":\"50\"}}}"
          },
          "lessonSlug": "understand-filters-and-read-cost"
        },
        {
          "slug": "know-that-ttl-is-not-an-exact-timer",
          "name": "Know that TTL is not an exact timer",
          "summary": "DynamoDB TTL uses an epoch-seconds attribute for expiry.",
          "example": {
            "language": "json",
            "code": "{\"reader\":{\"S\":\"temporary\"},\"book\":{\"S\":\"practice\"},\"expiresAt\":{\"N\":\"1800000000\"}}"
          },
          "lessonSlug": "know-that-ttl-is-not-an-exact-timer"
        },
        {
          "slug": "remove-one-sample-item",
          "name": "Remove one sample item",
          "summary": "DeleteItem targets one full key. A condition can be added when deletion must depend on the current item state.",
          "example": {
            "language": "json",
            "code": "{\"TableName\":\"cma-books\",\"Key\":{\"reader\":{\"S\":\"mia\"},\"book\":{\"S\":\"moon-trip\"}},\"ReturnValues\":\"ALL_OLD\"}"
          },
          "lessonSlug": "remove-one-sample-item"
        }
      ]
    }
  ]
}
