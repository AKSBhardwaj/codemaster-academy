    {
      "type": "code",
      "language": "lua",
      "title": "Join text",
      "code": "local name = \"Ravi\"\nprint(\"Hi, \" .. name .. \"!\")",
      "runnable": false
    },
    {
      "type": "heading",
      "level": 3,
      "text": "How the example works"
    },
    {
      "type": "paragraph",
      "text": "The .. operators join three text pieces. They do not add spaces by themselves."
    },
